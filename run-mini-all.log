# =====================================================================
# ORPO (RL) SMOKE TEST config for Qwen2.5-1.5B-Instruct
# =====================================================================
# 목적: 파이프라인 점검용. 데이터 20쌍 + max_steps 3 → 약 5–10분 내 완주.
#   - 데이터: data/train_rl-orpo-smoke.jsonl  (make_rl_orpo_data.py 생성)
#   - 출력은 outputs/qwen2.5-1.5b-rl-orpo-smoke 로 분리 (real run 오염 방지)
#
# 검증 포인트:
#   ① 데이터 로드 & passthrough 정상  ② orpo loss / rewards.logps / rewards/
#   odds_ratio_loss 로그 출력  ③ 어댑터 저장  ④ merge-lora 성공
# =====================================================================

base_model: ./data/sft-mini-out/merged
model_type: Qwen2ForCausalLM
tokenizer_type: AutoTokenizer

# ----- precision -----
bf16: true
tf32: true
flash_attention: false
attn_implementation: sdpa

# ----- ORPO settings -----
rl: orpo
orpo_alpha: 1.0            # trl ORPOConfig.beta 로 매핑됨

# ----- dataset -----
datasets:
  - path: data/orpo-mini-in/train_rl-orpo.jsonl   # mini 전용 (symlink → out)
    type: passthrough               # 메시지 리스트 {prompt, chosen[], rejected[]} 그대로 전달
    chat_template: chatml

skip_prepare_dataset: true   # axolotl 사전처리(문자열 전제 길이필터) 생략 — TRL 이 직접 토크나이즈
val_set_size: 0.0
dataset_prepared_path: ./data/orpo-mini-out/dataset_prepared

# ----- context -----
sequence_len: 1024
pad_to_sequence_len: true

# ----- LoRA -----
adapter: lora
lora_r: 16
lora_alpha: 32
lora_dropout: 0.05
lora_target_modules:
  - q_proj
  - k_proj
  - v_proj
  - o_proj
  - gate_proj
  - up_proj
  - down_proj

# ----- output -----
output_dir: ./data/orpo-mini-out/adapter

# ----- training -----
max_steps: 3                           # smoke: 3 step 만 돌고 종료
micro_batch_size: 1                    # smoke: 안전하게 1
gradient_accumulation_steps: 2
learning_rate: 1.0e-5
lr_scheduler_type: cosine
warmup_steps: 1
weight_decay: 0.0
optimizer: adamw_torch
logging_steps: 1
save_steps: 3
save_total_limit: 1
evals_per_epoch: 0

# ----- memory -----
gradient_checkpointing: true
gradient_checkpointing_kwargs:
  use_reentrant: false

# ----- Liger -----
plugins:
  - orpo_passthrough_plugin.ORPOPassthroughPlugin   # orpo+passthrough 조합 활성화
  - axolotl.integrations.liger.LigerPlugin

# ----- logging -----
wandb_project:
wandb_entity:
wandb_watch:
wandb_name:
wandb_log_model:
hub_model_id:
+ set +x
input: data/orpo-mini-out/train_rl-orpo.jsonl, data/orpo-mini-config/qwen2.5-1.5b-rl-orpo-mini.yaml
output: (stdout)

